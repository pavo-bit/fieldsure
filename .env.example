# ====================================
# FieldSure Environment Variables
# ====================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ---- Database ----
POSTGRES_USER=fieldsure
POSTGRES_PASSWORD=fieldsure_dev
POSTGRES_DB=fieldsure
DATABASE_URL=postgresql://fieldsure:fieldsure_dev@localhost:5432/fieldsure

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-use-64-chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-use-64-chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- S3 / MinIO ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fieldsure-images

# ---- ML Service ----
ML_SERVICE_URL=http://localhost:8000
# Shared secret for API <-> ML service authentication (REQUIRED in production)
ML_SHARED_SECRET=dev-ml-secret-change-in-production

# ---- Signing (Development) ----
SIGNING_ALGORITHM=RSA-SHA256
# SIGNING_PRIVATE_KEY_PATH=./keys/private.pem
# SIGNING_PUBLIC_KEY_PATH=./keys/public.pem
