# ====================================
# FieldSure Environment Variables (EXAMPLE)
# ====================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ---- Database ----
POSTGRES_USER=fieldsure
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_DB=fieldsure
DATABASE_URL=postgresql://fieldsure:<YOUR_POSTGRES_PASSWORD>@localhost:5432/fieldsure

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_ACCESS_SECRET=<YOUR_JWT_ACCESS_SECRET_64_CHARS_MIN>
JWT_REFRESH_SECRET=<YOUR_JWT_REFRESH_SECRET_64_CHARS_MIN>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- S3 / MinIO ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=<YOUR_S3_ACCESS_KEY>
S3_SECRET_KEY=<YOUR_S3_SECRET_KEY>
S3_BUCKET=fieldsure-images

# ---- Storage Backend (Phase 2) ----
# Options: local, s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/evidence

# S3 configuration (when STORAGE_BACKEND=s3)
AWS_REGION=us-east-1
AWS_S3_BUCKET=fieldsure-evidence
# AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY>
# AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_KEY>

# ---- ML Service ----
ML_SERVICE_URL=http://localhost:8000

# ---- Signing (Development) ----
SIGNING_ALGORITHM=RSA-SHA256
# EVIDENCE_PRIVATE_KEY=<PEM_CONTENT>
# EVIDENCE_PUBLIC_KEY=<PEM_CONTENT>

# ---- Timestamp Service (Phase 2) ----
TIMESTAMP_SERVICE_ENABLED=false
# TIMESTAMP_SERVICE_URL=http://timestamp.digicert.com

# ---- Environment ----
NODE_ENV=development
PORT=3000

# ---- App Version Compatibility (optional) ----
# MIN_APP_VERSION=1.0.0
