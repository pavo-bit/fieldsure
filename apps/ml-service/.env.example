# FieldSure ML Service — Environment Configuration
# Copy to .env and fill with actual values

# Service Configuration
ML_DEBUG=true
ML_APP_VERSION=0.1.0

# Network Binding (use 127.0.0.1 or internal IP in production, NOT 0.0.0.0)
ML_BIND_HOST=0.0.0.0
ML_BIND_PORT=8000

# Service-to-Service Authentication
# REQUIRED in production: set either SHARED_SECRET or enable MTLS
ML_SHARED_SECRET=
# ML_MTLS_ENABLED=false
# ML_MTLS_CA_CERT_PATH=/path/to/ca.crt
# ML_MTLS_CERT_PATH=/path/to/service.crt
# ML_MTLS_KEY_PATH=/path/to/service.key

# S3 / MinIO
ML_S3_ENDPOINT=http://localhost:9000
ML_S3_ACCESS_KEY=minioadmin
ML_S3_SECRET_KEY=minioadmin
ML_S3_BUCKET=fieldsure-images
ML_S3_REGION=us-east-1

# API Service
ML_API_SERVICE_URL=http://localhost:3000

# CORS (empty in production - internal service only)
ML_CORS_ORIGINS=["http://localhost:3000"]

# Image Validation
ML_MAX_IMAGE_SIZE_MB=20
ML_MIN_IMAGE_RESOLUTION=1920
ML_MAX_IMAGE_RESOLUTION=8192
ML_REQUEST_TIMEOUT_SECONDS=30
ML_MAX_IMAGE_PIXELS=178956970

# URL Allowlist (hosts allowed for image fetching)
ML_ALLOWED_IMAGE_HOSTS=["localhost","127.0.0.1","minio"]

# Signed URL Validation (optional security layer)
# ML_SIGNED_URL_SECRET=
ML_SIGNED_URL_MAX_AGE_SECONDS=3600
